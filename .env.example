# Database
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_NAME=waifubot

# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_NAME=your_bot_name

# AI Provider (OpenAI-compatible)
# Providers:
#   OpenAI:  AI_KEY=sk-...  AI_MODEL=gpt-4.1-mini           AI_BASE_URL=
#   Gemini:  AI_KEY=AIza... AI_MODEL=gemini-2.5-flash        AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:    AI_KEY=gsk_... AI_MODEL=llama-3.3-70b-versatile AI_BASE_URL=https://api.groq.com/openai/v1
AI_KEY=your_api_key
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=

# Features
KEEP_ALIVE=false  # set to true only on platforms like Replit/Railway
